{
    "name": "pmochine/laravel-nova-hashids",
    "description": "♺ Laravel Nova Hashids card. Convert your ids.",
    "keywords": [
        "laravel",
        "nova",
        "hashids",
        "hashid",
        "hash",
        "ids",
        "youtube",
        "bitly",
        "encrypt",
        "decrypt",
        "obfuscate"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Mochine",
            "email": "mail@philippmochine.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "vinkla/hashids": "^13.0|^14.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "sqids/sqids": "^0.5"
    },
    "conflict": {
        "laravel/nova": "<5.0|>=6.0"
    },
    "autoload": {
        "psr-4": {
            "Pmochine\\LaravelNovaHashids\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pmochine\\LaravelNovaHashids\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pmochine\\LaravelNovaHashids\\CardServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
